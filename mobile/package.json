{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:apk": "eas build -p android --profile preview",
    "build:prod": "eas build -p android --profile production",
    "update:preview": "eas update --branch preview --environment preview --message \"preview update\"",
    "update:production": "eas update --branch production --environment production --message \"production update\""
  },
  "dependencies": {
    "@expo-google-fonts/cairo": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "axios": "^1.13.6",
    "expo": "~55.0.5",
    "expo-constants": "~55.0.7",
    "expo-linear-gradient": "~55.0.8",
    "expo-location": "^55.1.2",
    "expo-notifications": "^55.0.12",
    "expo-status-bar": "~55.0.4",
    "expo-updates": "~55.0.13",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.2",
    "react-native-maps": "1.26.20",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.0"
  },
  "private": true,
  "devDependencies": {
    "serve": "^14.2.6"
  }
}
