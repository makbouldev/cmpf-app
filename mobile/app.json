{
  "expo": {
    "name": "Allo CMPF",
    "slug": "allo-cmpf",
    "version": "1.0.0",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/bf037f55-078a-4f66-b42a-d0138c49848a"
    },
    "orientation": "portrait",
    "icon": "./assets/Applogo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/Applogo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.cmpf.ambulance",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "SCHEDULE_EXACT_ALARM",
        "WAKE_LOCK",
        "VIBRATE",
        "USE_FULL_SCREEN_INTENT",
        "RECEIVE_BOOT_COMPLETED"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/Applogo.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/Applogo.png"
      }
    },
    "plugins": [
      "./plugins/withAlarmNative",
      "react-native-maps",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#1796f2"
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "bf037f55-078a-4f66-b42a-d0138c49848a"
      }
    },
    "owner": "noureddine2003"
  }
}
